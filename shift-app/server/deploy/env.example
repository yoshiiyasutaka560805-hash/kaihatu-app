# 勤務表アプリ 環境変数の例（コピーして使う。実値・秘密情報はGitに入れない）
#   Linux  : /etc/shift-app/env に置く（権限 0640 root:shift-app）。systemd の EnvironmentFile から読む
#   Windows: install-windows.ps1 が NSSM の AppEnvironmentExtra に設定する（値はスクリプト引数で指定）
# 書式は「NAME=値」（引用符・export は付けない）。行頭 # はコメント。

# --- 待受 ---------------------------------------------------------
# 待受ポート（既定 8443）
PORT=8443
# 待受アドレス（既定 127.0.0.1＝この端末のみ）。リバースプロキシ構成では 127.0.0.1 のままにする。
# プロキシなしで社内LANに直接公開する場合のみ 0.0.0.0 または社内NICのIPを明示（TLS_CERT/TLS_KEY 必須）。
HOST=127.0.0.1

# --- データ -------------------------------------------------------
# データ保存先（users.json / months / backups / audit.log / audit/ / sessions.json）。専用アカウントだけが読み書きできること。
DATA_DIR=/var/lib/shift-app
# 月ごとのバックアップ世代数（既定 30）。※同一ディスクのため、別媒体への退避は deploy/backup.sh|ps1 で行う。
BACKUP_KEEP=30

# --- HTTPS --------------------------------------------------------
# 本サーバー自身でTLS終端する場合のみ（Secure Cookie・HSTS が自動で有効）。プロキシでTLS終端する場合は不要。
#TLS_CERT=/etc/shift-app/server.crt
#TLS_KEY=/etc/shift-app/server.key
# プロキシでTLS終端する場合は 1（Cookie に Secure を付ける）。
SECURE_COOKIE=1

# --- リバースプロキシ配下（nginx / IIS ARR）-------------------------
# 1 のときだけ X-Forwarded-For の先頭をクライアントIPとして使う（ロック・監査ログのIP）。既定は信用しない。
# プロキシ側で「受信した X-Forwarded-For を破棄し、接続元IPで上書き」する設定が前提（nginx.conf.example 参照）。
TRUST_PROXY=1
# X-Forwarded-For を信用する「直接の接続元」。既定はこの端末のループバック（127.0.0.1/::1）のみ。
# プロキシが別ホストの場合のみ、そのIPをカンマ区切りで追加。
#TRUST_PROXY_IPS=192.168.10.5
# ブラウザからアクセスするURLのOrigin（CSRF検証の許可に追加。カンマ区切りで複数可。末尾スラッシュなし）。
# プロキシが Host ヘッダを書き換える構成（IIS ARR 既定など）では必須。
PUBLIC_ORIGIN=https://shift.example.local

# --- セッション・ログ ----------------------------------------------
# ログイン有効時間（時間。既定 8。延長なし）。再起動しても有効期限内は維持される（data/sessions.json にハッシュで保存）。
SESSION_HOURS=8
# 監査ログ（data/audit.log）は月が変わるか AUDIT_MAX_BYTES（既定 5242880=5MB）を超えると data/audit/ へ退避される。
#AUDIT_MAX_BYTES=5242880
# 退避済みログの保管日数。未設定または 0 なら削除しない（保管期間は法人の個人情報保護方針に従い決める）。
# 値を設定すると、その日数を超えた data/audit/audit-*.log を自動削除する（起動時と6時間ごと）。
#AUDIT_RETENTION_DAYS=1095
